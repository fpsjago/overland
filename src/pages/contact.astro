---
import BaseLayout from '../layouts/BaseLayout.astro';

// Set PUBLIC_FORM_ENDPOINT (and PUBLIC_FORM_ACCESS_KEY for Web3Forms) in .env
// to make the form send. Without it the page runs as an honest demo.
const formEndpoint = import.meta.env.PUBLIC_FORM_ENDPOINT?.trim() || undefined;
const formAccessKey = import.meta.env.PUBLIC_FORM_ACCESS_KEY?.trim() || undefined;
---

<BaseLayout
  title="Contact & Booking — OVERLAND"
  description="Start planning your expedition. We respond to all inquiries within 24 hours."
>
  <!-- Split layout -->
  <div class="min-h-screen grid grid-cols-1 lg:grid-cols-2">
    <!-- Left: info panel -->
    <div
      class="flex flex-col justify-between px-8 md:px-16 pt-40 pb-16 bg-panel"
    >
      <div>
        <p class="coords text-xs mb-8 text-accent-ink">CONTACT / START HERE</p>
        <h1
          class="font-heading font-black italic leading-none mb-8 text-[length:clamp(3rem,6vw,5rem)] text-cream"
        >
          Book an
          <br />
          Expedition
        </h1>
        <p
          class="font-body leading-relaxed mb-16 text-cream/65 text-[length:1.0625rem] max-w-[36ch]"
        >
          Every expedition begins with a conversation. Tell us where you want to go and what you're looking for. We'll match you to the right journey and the right guide.
        </p>

        <div class="space-y-8 mb-16">
          {[
            {
              label: 'Response Time',
              value: 'Within 24 hours',
            },
            {
              label: 'Email',
              // example.com is reserved (RFC 2606): it never reaches a real
              // inbox. Replace with your own address.
              value: 'book@example.com',
            },
            {
              label: 'Office',
              value: 'Punta Arenas, Chile (Global Operations)',
            },
          ].map(item => (
            <div class="border-b pb-6 border-cream/10">
              <p class="coords text-xs mb-1 text-cream/70">{item.label}</p>
              <p class="font-body text-cream/80">{item.value}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Decorative coordinates -->
      <p class="coords text-xs text-cream/70">
        -53.1638° S, -70.9171° W · PUNTA ARENAS
      </p>
    </div>

    <!-- Right: form -->
    <div
      class="flex flex-col justify-center px-8 md:px-16 pt-24 lg:pt-40 pb-16 bg-canvas"
    >
      <form
        id="contact-form"
        class="space-y-6 max-w-lg"
        novalidate
        action={formEndpoint}
        method={formEndpoint ? 'post' : undefined}
        data-endpoint={formEndpoint}
      >
        {formAccessKey && <input type="hidden" name="access_key" value={formAccessKey} />}
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label
              for="firstName"
              class="block font-heading font-bold text-xs uppercase mb-2 text-muted tracking-[0.1em]"
            >
              First Name *
            </label>
            <input
              type="text"
              id="firstName"
              name="firstName"
              autocomplete="given-name"
              required
              aria-describedby="firstName-error"
              class="field w-full px-4 py-3 font-body text-ink"
            />
            <p id="firstName-error" class="field-error" hidden>Enter your first name.</p>
          </div>
          <div>
            <label
              for="lastName"
              class="block font-heading font-bold text-xs uppercase mb-2 text-muted tracking-[0.1em]"
            >
              Last Name *
            </label>
            <input
              type="text"
              id="lastName"
              name="lastName"
              autocomplete="family-name"
              required
              aria-describedby="lastName-error"
              class="field w-full px-4 py-3 font-body text-ink"
            />
            <p id="lastName-error" class="field-error" hidden>Enter your last name.</p>
          </div>
        </div>

        <div>
          <label
            for="email"
            class="block font-heading font-bold text-xs uppercase mb-2 text-muted tracking-[0.1em]"
          >
            Email Address *
          </label>
          <input
            type="email"
            id="email"
            name="email"
            autocomplete="email"
            required
            aria-describedby="email-error"
            class="field w-full px-4 py-3 font-body text-ink"
          />
          <p id="email-error" class="field-error" hidden>Enter an email address like name@example.com.</p>
        </div>

        <div>
          <label
            for="destination"
            class="block font-heading font-bold text-xs uppercase mb-2 text-muted tracking-[0.1em]"
          >
            Destination of Interest
          </label>
          <select
            id="destination"
            name="destination"
            class="field w-full px-4 py-3 font-body text-ink"
          >
            <option value="">Select a destination…</option>
            <option>Patagonia</option>
            <option>Iceland</option>
            <option>Sahara</option>
            <option>Himalayas</option>
            <option>East Africa</option>
            <option>Amazon</option>
            <option>Borneo</option>
            <option>Atacama</option>
            <option>Alaska</option>
            <option>Norwegian Fjords</option>
            <option>Custom / Not Listed</option>
          </select>
        </div>

        <div>
          <label
            for="groupSize"
            class="block font-heading font-bold text-xs uppercase mb-2 text-muted tracking-[0.1em]"
          >
            Group Size
          </label>
          <select
            id="groupSize"
            name="groupSize"
            class="field w-full px-4 py-3 font-body text-ink"
          >
            <option value="">Select group size…</option>
            <option>Solo (1 person)</option>
            <option>2 people</option>
            <option>3–4 people</option>
            <option>5–8 people</option>
          </select>
        </div>

        <div>
          <label
            for="message"
            class="block font-heading font-bold text-xs uppercase mb-2 text-muted tracking-[0.1em]"
          >
            Tell Us About Your Expedition
          </label>
          <textarea
            id="message"
            name="message"
            rows={5}
            placeholder="Where do you want to go? What's your experience level? When are you thinking?"
            class="field w-full px-4 py-3 font-body resize-none text-ink"
          />
        </div>

        <button
          type="submit"
          class="form-submit w-full py-4 font-heading font-bold uppercase text-sm bg-accent text-on-accent tracking-[0.15em]"
        >
          Send Expedition Inquiry
        </button>

        <!-- Announced to screen readers; filled in by the script below. -->
        <p id="form-status" class="form-status" role="status" aria-live="polite"></p>

        <p class="font-body text-xs text-center text-muted">
          We respond to all inquiries within 24 hours. Your information is never shared with third parties.
        </p>
      </form>

      <!-- Form submission script -->
      <!-- Form states: invalid (field messages, focus moves to the first
           problem) and valid. With PUBLIC_FORM_ENDPOINT set at build time a
           valid form POSTs there (a JSON response is expected, as Formspree
           and Web3Forms return) and reports sending / sent / failed. Without
           it the form is a demo and says so: nothing is sent.
           Bound on astro:page-load so it also works after a client-side
           navigation to this page. -->
      <script>
        function initContactForm(): void {
          const form = document.getElementById('contact-form');
          if (!(form instanceof HTMLFormElement) || form.dataset['bound']) return;
          form.dataset['bound'] = 'true';

          const status = document.getElementById('form-status');
          const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
          const fields = Array.from(
            form.querySelectorAll<HTMLInputElement>('input[required]'),
          );

          const setError = (field: HTMLInputElement, show: boolean): void => {
            const message = document.getElementById(`${field.id}-error`);
            field.setAttribute('aria-invalid', show ? 'true' : 'false');
            if (message) message.hidden = !show;
          };

          // Clear an error as soon as the visitor fixes the field.
          fields.forEach((field) =>
            field.addEventListener('input', () => {
              if (field.getAttribute('aria-invalid') === 'true' && field.checkValidity()) setError(field, false);
            }),
          );

          const endpoint = form.dataset['endpoint'];
          const submitLabel = submit?.textContent?.trim() ?? 'Send';

          const say = (text: string, state: 'success' | 'error' | 'pending'): void => {
            if (!status) return;
            status.textContent = text;
            status.dataset['state'] = state;
          };

          const onValid = async (): Promise<void> => {
            if (!endpoint) {
              say('Demo form: nothing was sent. See CUSTOMIZATION.md to connect Formspree or Web3Forms.', 'success');
              return;
            }
            const firstName = form.querySelector<HTMLInputElement>('#firstName')?.value.trim();
            if (submit) {
              submit.disabled = true;
              submit.textContent = 'Sending…';
            }
            say('Sending your inquiry…', 'pending');
            try {
              const response = await fetch(endpoint, {
                method: 'POST',
                body: new FormData(form),
                headers: { Accept: 'application/json' },
              });
              if (!response.ok) throw new Error(`HTTP ${response.status}`);
              say(`Thank you${firstName ? `, ${firstName}` : ''}. Your inquiry has been sent and a guide will reply within 24 hours.`, 'success');
              form.reset();
              if (submit) submit.textContent = 'Inquiry Sent';
            } catch {
              say('Sorry, your inquiry could not be sent. Please try again, or email us directly.', 'error');
              if (submit) {
                submit.disabled = false;
                submit.textContent = submitLabel;
              }
            }
          };

          form.addEventListener('submit', (e) => {
            e.preventDefault();
            const invalid = fields.filter((field) => !field.checkValidity());
            fields.forEach((field) => setError(field, invalid.includes(field)));
            if (invalid.length > 0) {
              if (status) {
                status.textContent = `Please check ${invalid.length === 1 ? 'one field' : `${invalid.length} fields`} above.`;
                status.dataset['state'] = 'error';
              }
              invalid[0]?.focus();
              return;
            }
            void onValid();
          });
        }

        document.addEventListener('astro:page-load', initContactForm);
      </script>
    </div>
  </div>
</BaseLayout>
