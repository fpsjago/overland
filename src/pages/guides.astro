---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { base, byId } from '../lib/utils';
import { responsiveImage } from '../lib/images';

const guides = byId(await getCollection('guides'));
const portraits = await Promise.all(guides.map((g) => responsiveImage(g.data.image, [400, 640])));
---

<BaseLayout
  title="Our Guides — OVERLAND"
  description="Meet the guides who lead OVERLAND expeditions. Born in the field. Certified, experienced, and deeply knowledgeable."
>
  <!-- Header -->
  <header class="pt-40 pb-16 px-6 md:px-12 bg-panel">
    <div class="max-w-6xl mx-auto">
      <p class="coords text-xs mb-6 text-accent-ink">MEET THE TEAM / LEAD GUIDES</p>
      <h1
        class="font-heading font-black italic leading-none mb-6 text-[length:clamp(3rem,8vw,7rem)] text-cream"
      >
        The People
        <br />
        Who Lead
      </h1>
      <p
        class="font-body leading-relaxed max-w-2xl text-cream/65 text-[length:1.0625rem]"
      >
        The guide determines the depth of the experience. Every OVERLAND lead guide is a specialist in their terrain — not a generalist with a map.
      </p>
    </div>
  </header>

  <!-- Guide cards -->
  <section class="py-24 px-6 md:px-12 bg-canvas">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
        {guides.map((guide, i) => {
          const g = guide.data;
          return (
            <article
              class="group"
              data-reveal={i % 2 === 0 ? 'slide-left' : 'slide-right'}
            >
              <!-- Portrait with 3D tilt via CSS hover -->
              <div
                class="relative overflow-hidden rounded mb-8 aspect-[4/5]"
               
                data-cursor="photo"
                data-tilt
              >
                <img
                  src={portraits[i]?.src}
                  srcset={portraits[i]?.srcset}
                  sizes="(min-width: 768px) 540px, 100vw"
                  alt={g.name}
                  width={portraits[i]?.width}
                  height={portraits[i]?.height}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                />

                <!-- Overlay on hover -->
                <div
                  class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 bg-[linear-gradient(to_top,rgba(15,26,11,0.85)_0%,transparent_60%)]"
                />

                <!-- Expeditions revealed on hover -->
                <div class="absolute bottom-0 left-0 right-0 p-6 translate-y-full group-hover:translate-y-0 transition-transform duration-500">
                  <p class="coords text-xs mb-3 text-accent-ink">EXPEDITIONS LISTED</p>
                  <div class="space-y-1">
                    {g.expeditions.map(exp => (
                      <p class="font-heading font-bold text-sm text-cream">{exp}</p>
                    ))}
                  </div>
                </div>
              </div>

              <!-- Name + Role -->
              <p class="coords text-xs mb-2 text-accent-ink">
                {String(i + 1).padStart(2, '0')} / GUIDE
              </p>
              <h2
                class="font-heading font-black italic leading-tight mb-1 text-[length:clamp(1.75rem,3vw,2.5rem)] text-primary"
              >
                {g.name}
              </h2>
              <p
                class="font-body mb-6 text-accent-ink text-[length:0.875rem]"
              >
                {g.role}
              </p>

              <p class="font-body leading-relaxed mb-6 text-muted">
                {g.bio}
              </p>

              <!-- Specialties -->
              <div class="flex flex-wrap gap-2">
                {g.specialties.map(s => (
                  <span
                    class="text-xs font-heading font-bold uppercase px-3 py-1.5 border border-hairline text-muted tracking-[0.08em]"
                  >
                    {s}
                  </span>
                ))}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- 3D Tilt script -->
  <script>
    document.querySelectorAll('[data-tilt]').forEach((el) => {
      const card = el as HTMLElement;
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        card.style.transform = `perspective(800px) rotateY(${x * 12}deg) rotateX(${-y * 12}deg) scale(1.02)`;
      });
      card.addEventListener('mouseleave', () => {
        card.style.transform = 'perspective(800px) rotateY(0deg) rotateX(0deg) scale(1)';
        card.style.transition = 'transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
      });
    });
  </script>
</BaseLayout>
