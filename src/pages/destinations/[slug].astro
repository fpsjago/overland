---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { base } from '../../lib/utils';
import { responsiveImage, socialImage } from '../../lib/images';

export async function getStaticPaths() {
  const destinations = await getCollection('destinations');
  return destinations.map((dest) => ({
    params: { slug: dest.id },
    props: { dest },
  }));
}

const { dest } = Astro.props;
const d = dest.data;

const difficultyLabel: Record<string, string> = {
  moderate: 'Moderate',
  challenging: 'Challenging',
  extreme: 'Extreme',
};

const hero = await responsiveImage(d.heroImage, [640, 1024, 1600]);
const ogImage = await socialImage(d.heroImage);
const gallery = await Promise.all(d.gallery.map((img) => responsiveImage(img, [480, 800])));
---

<BaseLayout
  title={`${d.name} Expeditions — OVERLAND`}
  description={`${d.name}: expedition travel to ${d.country}. ${d.terrain.join(', ')} terrain. Best season: ${d.season}.`}
  image={ogImage}
>
  <!-- Hero — full-bleed image + destination name -->
  <div class="on-dark relative h-[90vh] overflow-hidden">
    <img
      src={hero.src}
      srcset={hero.srcset}
      sizes="100vw"
      width={hero.width}
      height={hero.height}
      alt={d.name}
      class="absolute inset-0 w-full h-full object-cover scale-105"
      fetchpriority="high"
      loading="eager"
      decoding="async"
      data-cursor="photo"
    />
    <div
      class="absolute inset-0 bg-[linear-gradient(to_bottom,rgba(15,26,11,0.2)_0%,rgba(15,26,11,0.7)_100%)]"
    />
    <div class="mapGrid absolute inset-0 pointer-events-none" aria-hidden="true" />

    <!-- Content -->
    <div class="absolute bottom-0 left-0 right-0 px-8 md:px-16 pb-16">
      <div class="max-w-5xl">
        <div class="flex flex-wrap items-center gap-4 mb-6">
          <span
            class={`badge-difficulty font-heading font-bold uppercase text-xs px-3 py-1.5 rounded-full tracking-[0.12em] text-parchment difficulty-${d.difficulty}`}
          >
            {difficultyLabel[d.difficulty] ?? d.difficulty}
          </span>
          <span class="coords text-xs text-cream/80">
            {d.region}
          </span>
          <span class="coords text-xs text-cream/70">
            {d.coordinates.lat.toFixed(4)}°, {d.coordinates.lng.toFixed(4)}°
          </span>
        </div>

        <h1
          class="font-heading font-black italic leading-none mb-4 text-[length:clamp(3rem,7vw,6rem)] text-cream"
        >
          {d.name}
        </h1>
        <p class="font-body text-[length:1.125rem] text-cream/65">
          {d.country}
        </p>
      </div>
    </div>
  </div>

  <!-- Detail content -->
  <div class="max-w-6xl mx-auto px-6 md:px-12 py-20">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">
      <!-- Main column -->
      <div class="lg:col-span-2">
        <!-- Highlights -->
        <div class="mb-16" data-reveal>
          <p class="coords text-xs mb-6 text-accent-ink">EXPEDITION HIGHLIGHTS</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {d.highlights.map((highlight, i) => (
              <div
                class="flex items-start gap-4 p-5 rounded bg-surface border border-hairline"
              >
                <span
                  class="font-heading font-black italic shrink-0 text-[length:1.75rem] text-accent-ink opacity-[0.4] leading-none"
                 
                  aria-hidden="true"
                >
                  {String(i + 1).padStart(2, '0')}
                </span>
                <p class="font-body text-ink text-[length:0.9375rem]">
                  {highlight}
                </p>
              </div>
            ))}
          </div>
        </div>

        <!-- Terrain -->
        <div class="mb-16" data-reveal>
          <p class="coords text-xs mb-6 text-accent-ink">TERRAIN TYPES</p>
          <div class="flex flex-wrap gap-3">
            {d.terrain.map(t => (
              <span
                class="font-heading font-bold uppercase text-xs px-4 py-2 border border-hairline text-muted tracking-[0.1em]"
              >
                {t}
              </span>
            ))}
          </div>
        </div>

        <!-- Gallery -->
        {d.gallery.length > 0 && (
          <div class="mb-16" data-reveal>
            <p class="coords text-xs mb-6 text-accent-ink">EXPEDITION GALLERY</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {gallery.map((img, i) => (
                <div
                  class="overflow-hidden rounded aspect-[4/3]"
                  data-cursor="photo"
                >
                  <img
                    src={img.src}
                    srcset={img.srcset}
                    sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
                    width={img.width}
                    height={img.height}
                    alt={`${d.name} expedition ${i + 1}`}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                  />
                </div>
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- Sidebar -->
      <div class="lg:col-span-1">
        <div
          class="sticky top-28 p-8 rounded bg-surface border border-hairline"
        >
          <p class="coords text-xs mb-6 text-accent-ink">EXPEDITION DETAILS</p>

          <div class="space-y-5">
            <div class="border-b pb-5 border-hairline">
              <p class="text-xs uppercase font-heading font-bold mb-1 text-muted tracking-[0.1em]">Best Season</p>
              <p class="font-body text-ink">{d.season}</p>
            </div>
            <div class="border-b pb-5 border-hairline">
              <p class="text-xs uppercase font-heading font-bold mb-1 text-muted tracking-[0.1em]">Difficulty</p>
              <p
                class={`badge-ink font-heading font-bold difficulty-${d.difficulty}`}
              >
                {difficultyLabel[d.difficulty] ?? d.difficulty}
              </p>
            </div>
            <div class="border-b pb-5 border-hairline">
              <p class="text-xs uppercase font-heading font-bold mb-1 text-muted tracking-[0.1em]">Coordinates</p>
              <p class="coords text-xs text-ink">
                {d.coordinates.lat.toFixed(4)}°<br />
                {d.coordinates.lng.toFixed(4)}°
              </p>
            </div>
            <div class="pb-2">
              <p class="text-xs uppercase font-heading font-bold mb-1 text-muted tracking-[0.1em]">Country</p>
              <p class="font-body text-ink">{d.country}</p>
            </div>
          </div>

          <a
            href={`${base}contact/`}
            class="mt-8 w-full flex items-center justify-center gap-3 py-4 font-heading font-bold uppercase text-sm transition-all duration-300 bg-accent text-on-accent tracking-[0.12em]"
           
            data-magnetic
          >
            Book This Destination
          </a>
          <a
            href={`${base}destinations/`}
            class="mt-3 w-full flex items-center justify-center gap-3 py-3 font-heading font-bold uppercase text-xs border transition-all duration-300 border-hairline text-muted tracking-[0.1em]"
          >
            ← All Destinations
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
