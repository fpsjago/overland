---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { base, byId } from '../../lib/utils';
import { responsiveImage } from '../../lib/images';

const journeys = byId(await getCollection('journeys'));
const thumbs = await Promise.all(journeys.map((j) => responsiveImage(j.data.heroImage, [400, 640, 800])));
---

<BaseLayout
  title="Expeditions — OVERLAND"
  description="Curated expedition itineraries from 12 to 21 days. Patagonia, Iceland, Sahara, Himalayas, East Africa."
>
  <!-- Header -->
  <header class="pt-40 pb-20 px-6 md:px-12 bg-panel">
    <div class="max-w-6xl mx-auto">
      <p class="coords text-xs mb-6 text-accent-ink">EXPEDITIONS / ALL JOURNEYS</p>
      <h1
        class="font-heading font-black italic leading-none mb-6 text-[length:clamp(3rem,8vw,7rem)] text-cream"
      >
        Our Journeys
      </h1>
      <p
        class="font-body leading-relaxed max-w-2xl text-cream/65 text-[length:1.0625rem]"
      >
        Each expedition is a complete arc — preparation, immersion, return. We don't sell tours. We design journeys.
      </p>
    </div>
  </header>

  <!-- Feature cascade -->
  <section class="py-20 bg-canvas">
    <div class="max-w-6xl mx-auto px-6">
      <div class="space-y-0 border-t border-hairline">
        {journeys.map((journey, i) => {
          const j = journey.data;
          return (
            <a
              href={`${base}journeys/${journey.id}/`}
              class="group flex flex-col md:flex-row gap-0 border-b border-hairline transition-colors duration-300 hover:bg-surface focus-visible:bg-surface focus-visible:outline-offset-[-3px]"
              data-reveal
            >
              <!-- Image -->
              <div
                class="md:w-64 lg:w-80 shrink-0 overflow-hidden min-h-[220px]"
               
                data-cursor="photo"
              >
                <img
                  src={thumbs[i]?.src}
                  srcset={thumbs[i]?.srcset}
                  sizes="(min-width: 1024px) 320px, (min-width: 768px) 256px, 100vw"
                  alt={j.title}
                  width={thumbs[i]?.width}
                  height={thumbs[i]?.height}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover min-h-[220px] transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105 group-focus-visible:scale-105"
                />
              </div>

              <!-- Content -->
              <div class="flex-1 flex flex-col justify-center px-8 py-10">
                <div class="flex flex-wrap items-center gap-4 mb-4">
                  <span
                    class={`badge-difficulty font-heading font-bold uppercase text-xs px-3 py-1 tracking-[0.1em] text-parchment difficulty-${j.difficulty}`}
                  >
                    {j.difficulty}
                  </span>
                  <span class="coords text-xs text-muted">
                    {j.durationDays} days
                  </span>
                  <span class="coords text-xs text-muted">
                    From ${j.price.toLocaleString()}
                  </span>
                </div>

                <h2
                  class="font-heading font-black italic leading-tight mb-3 text-[length:clamp(1.5rem,3vw,2.25rem)] text-primary"
                >
                  {j.title}
                </h2>

                {j.excerpt && (
                  <p class="font-body leading-relaxed mb-4 max-w-2xl text-muted">
                    {j.excerpt}
                  </p>
                )}

                <span
                  class="inline-flex items-center gap-2 font-heading font-bold uppercase text-xs mt-2 text-accent-ink tracking-[0.12em]"
                >
                  View Expedition
                  <svg class="transition-transform duration-300 group-hover:translate-x-1.5 group-focus-visible:translate-x-1.5" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </div>

              <!-- Day count decorative -->
              <div
                class="hidden lg:flex items-center justify-center w-24 shrink-0 border-l border-hairline"
              >
                <div class="text-center px-4" aria-hidden="true">
                  <!-- Decorative numeral (the duration is already stated as
                       text in the meta row), so it is drawn as generated
                       content and hidden from assistive tech: WCAG 1.4.3
                       exempts pure decoration from contrast. -->
                  <span
                    aria-hidden="true"
                    data-num={j.durationDays}
                    class="font-heading font-black italic block text-[length:2.5rem] text-hairline leading-none transition-colors duration-300 group-hover:text-accent-ink group-focus-visible:text-accent-ink before:content-[attr(data-num)]"
                  ></span>
                  <span class="coords text-xs block text-muted">days</span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 px-6 text-center bg-surface">
    <p class="coords text-xs mb-4 text-accent-ink">CUSTOM EXPEDITION</p>
    <h2
      class="font-heading font-black italic leading-none mb-6 text-[length:clamp(2rem,5vw,3.5rem)] text-primary"
    >
      Don't See Your Journey?
    </h2>
    <p class="font-body leading-relaxed mb-8 max-w-xl mx-auto text-muted">
      We design custom expeditions for groups who know exactly where they want to go. Tell us your destination. We'll handle everything else.
    </p>
    <a
      href={`${base}contact/`}
      class="inline-flex items-center gap-3 px-8 py-4 font-heading font-bold uppercase text-sm bg-accent text-on-accent tracking-[0.12em]"
     
      data-magnetic
    >
      Design a Custom Expedition
    </a>
  </section>
</BaseLayout>
