# Copy to .env and fill in. Both values are read at build time and end up in
# the page (they are public), so never put a secret here.

# Contact form backend. Unset = the form is an honest demo and sends nothing.
#   Formspree:  https://formspree.io/f/xxxxxxxx
#   Web3Forms:  https://api.web3forms.com/submit
PUBLIC_FORM_ENDPOINT=

# Web3Forms only: your access key (sent as the access_key field).
PUBLIC_FORM_ACCESS_KEY=
